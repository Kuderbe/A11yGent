A11Y_GENT_OPENAI_BASE_URL=http://localhost:6655/litellm/v1
A11Y_GENT_OPENAI_API_KEY=replace-me
A11Y_GENT_MODEL=gpt-5-mini
A11Y_GENT_MCP_URL=http://192.168.64.4:8765/mcp
# Browser MCP (setup-only): stdio launches Chrome DevTools MCP via npx; url
# connects to a running MCP. chrome_url attaches the stdio MCP to a running
# debuggable Chrome instead of launching its own.
A11Y_GENT_BROWSER_MCP_MODE=stdio
# A11Y_GENT_BROWSER_MCP_URL=http://127.0.0.1:3000/mcp
# A11Y_GENT_BROWSER_CHROME_URL=http://127.0.0.1:9222


